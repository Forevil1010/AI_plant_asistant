.home-page {
  min-height: 100vh;
  padding-bottom: 48rpx;
}

.home-band {
  position: relative;
  display: flex;
  min-height: 286rpx;
  overflow: hidden;
  background: #174f37;
  color: #ffffff;
}

.home-band__content {
  position: relative;
  z-index: 2;
  width: 68%;
  padding: 42rpx 0 36rpx 32rpx;
}

.home-kicker,
.home-title,
.home-copy {
  display: block;
}

.home-kicker {
  color: #bfe0cd;
  font-size: 24rpx;
}

.home-title {
  margin-top: 12rpx;
  font-size: 42rpx;
  line-height: 1.25;
  font-weight: 700;
}

.home-copy {
  margin-top: 18rpx;
  max-width: 420rpx;
  color: #e1eee6;
  font-size: 24rpx;
  line-height: 1.55;
}

.home-band__image {
  position: absolute;
  top: 0;
  right: 0;
  width: 38%;
  height: 100%;
  opacity: 0.7;
}

.home-content {
  padding: 24rpx 28rpx 0;
}

.search-row {
  display: grid;
  grid-template-columns: 1fr 128rpx;
  gap: 12rpx;
}

.search-input {
  height: 80rpx;
  padding: 0 24rpx;
  border: 1rpx solid #d9dfda;
  border-radius: 8rpx;
  background: #ffffff;
  font-size: 27rpx;
}

.search-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 128rpx;
  height: 80rpx;
  padding: 0;
  border-radius: 8rpx;
  background: #1f2923;
  color: #ffffff;
  font-size: 26rpx;
  line-height: 80rpx;
}

.search-panel {
  margin-top: 16rpx;
  padding: 18rpx 22rpx;
}

.search-panel__head {
  margin-bottom: 8rpx;
}

.search-result {
  display: flex;
  gap: 20rpx;
  padding: 18rpx 0;
  border-top: 1rpx solid #edf0ec;
}

.search-result__image {
  flex: 0 0 auto;
  width: 126rpx;
  height: 126rpx;
  border-radius: 6rpx;
  background: #e7ebe7;
}

.search-result__content {
  min-width: 0;
}

.search-result__name,
.search-result__latin,
.search-result__summary {
  display: block;
}

.search-result__name {
  font-size: 29rpx;
  font-weight: 650;
}

.search-result__latin {
  margin-top: 3rpx;
  color: #7b837d;
  font-size: 21rpx;
}

.search-result__summary {
  margin-top: 8rpx;
  color: #59635c;
  font-size: 23rpx;
  line-height: 1.45;
}

.search-empty {
  padding: 28rpx 20rpx;
}

.tool-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
}

.tool-item {
  min-height: 190rpx;
  padding: 22rpx 18rpx;
  border-radius: 8rpx;
}

.tool-item--green {
  background: #e3f1e8;
  color: #155a3d;
}

.tool-item--yellow {
  background: #fff1ce;
  color: #785200;
}

.tool-item--coral {
  background: #fce5df;
  color: #8c3d32;
}

.tool-item__mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  border: 2rpx solid currentColor;
  border-radius: 50%;
  font-size: 22rpx;
  font-weight: 700;
}

.tool-item__title,
.tool-item__copy {
  display: block;
}

.tool-item__title {
  margin-top: 18rpx;
  font-size: 27rpx;
  font-weight: 650;
}

.tool-item__copy {
  margin-top: 5rpx;
  font-size: 21rpx;
  opacity: 0.76;
}

.task-list {
  padding: 0 22rpx;
}

.task-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: 112rpx;
  border-bottom: 1rpx solid #edf0ec;
}

.task-row:last-child {
  border-bottom: 0;
}

.task-row__status {
  width: 12rpx;
  height: 48rpx;
  border-radius: 6rpx;
  background: #4d9b72;
}

.task-row__status--late {
  background: #d57458;
}

.task-row__main {
  flex: 1;
  min-width: 0;
}

.task-row__title-line {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.task-row__title,
.task-row__time {
  display: block;
}

.task-row__title {
  font-size: 27rpx;
  font-weight: 600;
}

.task-row__time {
  margin-top: 5rpx;
  color: #747c76;
  font-size: 22rpx;
}

.task-row__done {
  width: 92rpx;
  height: 58rpx;
  padding: 0;
  border-radius: 8rpx;
  background: #eef6f1;
  color: #176b45;
  font-size: 23rpx;
  line-height: 58rpx;
}

.tip-band {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  padding: 26rpx;
  border-left: 8rpx solid #e1a63b;
  background: #fff9ea;
}

.tip-band__label {
  flex: 0 0 auto;
  color: #9a6807;
  font-size: 22rpx;
  font-weight: 750;
}

.tip-band__copy {
  color: #5b4a2d;
  font-size: 25rpx;
  line-height: 1.65;
}

.featured-scroll {
  width: 100%;
  white-space: nowrap;
}

.featured-card {
  display: inline-block;
  width: 260rpx;
  margin-right: 14rpx;
  overflow: hidden;
  vertical-align: top;
}

.featured-card__image {
  width: 100%;
  height: 180rpx;
  background: #e4e9e5;
}

.featured-card__body {
  padding: 18rpx;
}

.featured-card__name,
.featured-card__meta {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
}

.featured-card__name {
  font-size: 27rpx;
  font-weight: 650;
}

.featured-card__meta {
  margin-top: 5rpx;
  color: #717a73;
  font-size: 21rpx;
}
