<view class="page plant-form-page">
  <view class="page-header">
    <text class="page-title">建立植物档案</text>
    <text class="page-subtitle">记录你如何称呼它、摆在哪里，以及从什么时候开始养护。</text>
  </view>

  <view class="photo-field" bindtap="chooseImage">
    <image class="photo-field__image" src="{{imagePath}}" mode="aspectFill" />
    <view class="photo-field__overlay">更换照片</view>
  </view>

  <view class="form-section">
    <text class="field-label">植物名称 *</text>
    <input class="input" value="{{name}}" maxlength="30" placeholder="例如：绿萝" bindinput="onNameInput" />

    <text class="field-label">昵称</text>
    <input class="input" value="{{nickname}}" maxlength="30" placeholder="例如：小绿" bindinput="onNicknameInput" />

    <text class="field-label">摆放位置</text>
    <input class="input" value="{{location}}" maxlength="30" placeholder="例如：客厅窗边" bindinput="onLocationInput" />

    <text class="field-label">获得日期</text>
    <picker mode="date" value="{{acquiredAt}}" bindchange="onDateChange">
      <view class="picker-field picker-arrow">{{acquiredAt}}</view>
    </picker>

    <text class="field-label">备注</text>
    <textarea class="textarea note-input" value="{{note}}" maxlength="300" placeholder="记录来源、换盆情况或其他信息" bindinput="onNoteInput" />
  </view>

  <button class="primary-button save-button" loading="{{saving}}" disabled="{{saving}}" bindtap="save">
    {{editingId ? '保存修改' : '添加到花园'}}
  </button>
</view>
