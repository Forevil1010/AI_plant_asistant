.photo-field {
  position: relative;
  width: 100%;
  height: 300rpx;
  overflow: hidden;
  border-radius: 8rpx;
  background: #e5eae6;
}
.photo-field__image {
  width: 100%;
  height: 100%;
}

.photo-field__overlay {
  position: absolute;
  right: 16rpx;
  bottom: 16rpx;
  min-height: 54rpx;
  padding: 0 20rpx;
  border-radius: 8rpx;
  background: rgba(26, 35, 29, 0.82);
  color: #ffffff;
  font-size: 23rpx;
  line-height: 54rpx;
}

.form-section {
  margin-top: 30rpx;
}

.picker-arrow {
  position: relative;
}

.picker-arrow::after {
  position: absolute;
  right: 24rpx;
  content: '›';
  color: #7d857f;
  font-size: 38rpx;
  transform: rotate(90deg);
}

.note-input {
  min-height: 170rpx;
}

.save-button {
  margin-top: 32rpx;
}
