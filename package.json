  "description": "AI园林助手 - 智能植物识别与养护管理",
  "main": "index.js",
  "scripts": {
    "dev:h5": "taro build --type h5 --watch",
    "build:h5": "taro build --type h5",
    "dev:weapp": "taro build --type weapp --watch",
    "build:weapp": "taro build --type weapp",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "typecheck": "tsc --noEmit",
    "test": "jest --passWithNoTests",
    "test:server": "npm test --prefix server",
    "check": "npm run typecheck && npm run lint && npm run test && npm run test:server"
  },
  "keywords": [
    "AI",
    "plant",
    "garden",
    "taro",
    "小程序"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@tarojs/components": "^4.2.1",
    "@tarojs/react": "^4.2.1",
    "@tarojs/runtime": "^4.2.1",
    "@tarojs/taro": "^4.2.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@babel/preset-react": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.6.2",
    "@tarojs/cli": "^4.2.1",
    "@tarojs/plugin-framework-react": "^4.2.1",
    "@tarojs/plugin-html": "^4.2.1",
    "@tarojs/plugin-platform-h5": "^4.2.1",
    "@tarojs/plugin-platform-weapp": "^4.2.1",
    "@tarojs/plugin-react-devtools": "^4.2.1",
    "@tarojs/webpack5-runner": "^4.2.1",
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@typescript-eslint/eslint-plugin": "^5.59.0",
    "@typescript-eslint/parser": "^5.59.0",
    "babel-preset-taro": "^4.2.1",
    "eslint": "^8.40.0",
    "eslint-config-taro": "^4.2.1",
    "eslint-plugin-react": "^7.32.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "jest": "^29.5.0",
    "react-refresh": "^0.14.2",
    "sass": "^1.62.0",
    "typescript": "^5.0.0"
